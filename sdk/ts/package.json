{
  "name": "@myzonerocks/gosslens",
  "version": "0.11.1",
  "description": "Web SDK for the gosslens camera and AR engine, over the wasm core.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myzonerocks/gosslens.git",
    "directory": "sdk/ts"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun test ./test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "bun run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "camera",
    "ar",
    "webassembly",
    "lens",
    "effects"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "typescript": "^7.0.0"
  }
}
