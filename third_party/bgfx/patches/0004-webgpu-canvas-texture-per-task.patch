+	WGPUTextureView SwapChainWGPU::currentTextureView()
+	{
+		// gosslens patch: a canvas surface's current texture is only valid
+		// within the JS task that acquired it - the compositor destroys it
+		// when the task yields - so the view is acquired lazily inside the
+		// frame that renders with it, never cached across a present.
+		if (NULL == m_textureView)
+		{
+			WGPUSurfaceTexture surfaceTexture = WGPU_SURFACE_TEXTURE_INIT;
+			wgpuSurfaceGetCurrentTexture(m_surface, &surfaceTexture);
+			if (NULL != surfaceTexture.texture)
+			{
+				m_textureView = WGPU_CHECK(wgpuTextureCreateView(surfaceTexture.texture, NULL) );
+				wgpuRelease(surfaceTexture.texture);
+			}
+		}
+
+		return m_textureView;
+	}
