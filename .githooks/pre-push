#!/bin/sh
# Run the required gates before any branch leaves the desktop, so a push that
# would fail hosted CI never spends runner minutes. main stays PR-only. Set
# GOSS_PREPUSH_FULL=1 to also cross-build android and web; --no-verify skips.
set -e

root="$(git rev-parse --show-toplevel)"
zig="$root/.local/zig/current/zig"
[ -x "$zig" ] || zig="$zig.exe"
[ -x "$zig" ] || zig=zig

# Provenance pattern for outgoing commit messages, assembled from halves so
# this file never contains the literal strings it bans. Mirrors gate.zig's
# message tokens; the scan is pure git+grep so it runs in milliseconds and
# works even when the toolchain is absent or the heavy gates would hang.
prov="co-auth:ored-by|generated: with|generated:-by|assisted:-by|co-devel:oped-by|ai-gen:erated|cla:ude|anthro:pic|chat:gpt|open:ai|copi:lot|gem:ini|deep:seek|cur:sor|cod:ex|winds:urf|aid:er|dev:in|qw:en|mist:ral|lla:ma|openro:uter|perple:xity|language: model|coding: agent|coding: assistant|ai: agent"
prov_re="$(printf '%s' "$prov" | tr -d ':')"

# Scans one outgoing rev range and refuses the push on a provenance hit.
scan_messages() {
  hits="$(git log --format='%B' "$@" < /dev/null 2>/dev/null | grep -iE "$prov_re" | head -3 || true)"
  if [ -n "$hits" ]; then
    echo "pre-push: an outgoing commit message carries tool or model provenance; rewrite it before pushing" >&2
    echo "$hits" | sed 's/^/pre-push:   /' >&2
    exit 1
  fi
}

gate_needed=0
while read -r local_ref local_sha remote_ref remote_sha; do
  # A deletion pushes the all-zero sha; there is nothing to gate.
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  # main is server-side squash-merge only, never a direct push.
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: refusing direct push to main; open a PR and squash-merge on green" >&2
    exit 1
  fi
  # Only branch refs carry source to gate; a tag is a release ref the release
  # workflow gates on its own.
  case "$remote_ref" in refs/heads/*) gate_needed=1 ;; *) continue ;; esac
  # The message scan runs first and per ref: no toolchain, no build, nothing
  # that can hang. A hit refuses the push before any heavy work.
  case "$remote_sha" in
    *[!0]*) scan_messages "$remote_sha..$local_sha" ;;
    *) scan_messages "$local_sha" --not --remotes=origin ;;
  esac
done

[ "$gate_needed" = 1 ] || exit 0

cd "$root"
echo "pre-push: running the required gates locally (ci + tracking); --no-verify to skip" >&2
"$zig" build ci
"$zig" build tracking-harness

if [ "${GOSS_PREPUSH_FULL:-}" = 1 ]; then
  # Opt-in: the platform lanes are heavier and are not required checks, so they
  # stay off the default push and run only when asked. Conformance is left to CI
  # because it can hang when it races another gate process on this machine.
  echo "pre-push: GOSS_PREPUSH_FULL set, also building android and web" >&2
  "$zig" build android
  ( cd sdk/ts && bun install --silent && bun run build && bun test )
fi

echo "pre-push: gates green" >&2
