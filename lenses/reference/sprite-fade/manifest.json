{
  "glf": "1.0",
  "id": "kit.reference.sprite-fade",
  "version": "1.0.0",
  "display_name": "Sprite Fade",
  "engine_compat": ">=0.5",
  "capabilities": [],
  "parameters": [
    {"name": "fade", "type": "float", "default": 1.0, "min": 0.0, "max": 1.0}
  ],
  "nodes": [
    {"id": "badge", "type": "sprite.2d", "inputs": {"frame": "camera"}, "params": {}, "sprite": {"x": 0.3, "y": 0.3, "w": 0.4, "h": 0.4, "opacity_param": "fade"}}
  ],
  "triggers": [
    {"when": "timer('x') >= 0.3", "action": {"kind": "param_ramp", "target": "fade", "to": 0.0, "duration_ms": 100, "curve": "linear"}}
  ]
}
