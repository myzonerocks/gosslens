{
  "name": "docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "check": "biome check . && vue-tsc --build --force && bun scripts/check-docs.ts",
    "format": "biome format --write .",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "check:docs": "bun scripts/check-docs.ts",
    "check:webkit": "bun scripts/webkit-render-check.mjs",
    "check:links": "bun scripts/check-links.ts"
  },
  "dependencies": {
    "@mdx-js/vue": "3.1.1",
    "@vueuse/core": "15.0.0",
    "minisearch": "7.2.0",
    "vue": "3.5.45",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@mdx-js/rollup": "3.1.1",
    "@playwright/test": "1.65.0",
    "@shikijs/rehype": "4.6.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "25.3.0",
    "@vitejs/plugin-vue": "6.0.10",
    "gray-matter": "4.0.3",
    "rehype-autolink-headings": "7.1.0",
    "rehype-slug": "6.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.6.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vue-tsc": "3.3.14"
  },
  "packageManager": "bun@1.4.0"
}
